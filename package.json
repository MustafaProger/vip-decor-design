{
  "name": "vip-decor-design",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/prepare-data.mjs",
    "dev": "concurrently -k -n api,web \"node server/index.mjs\" \"vite --host 127.0.0.1\"",
    "prebuild": "node scripts/prepare-data.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs server/*.test.mjs",
    "qa": "node scripts/qa.mjs",
    "qa:redesign": "node scripts/qa-redesign.mjs",
    "qa:liquid": "node scripts/qa-liquid-glass.mjs",
    "qa:keyboard": "node scripts/qa-keyboard.mjs",
    "qa:media": "node scripts/qa-media.mjs",
    "qa:directions": "node scripts/qa-directions.mjs",
    "qa:polish": "node scripts/qa-ui-polish.mjs",
    "qa:refresh": "node scripts/qa-september-refresh.mjs",
    "qa:hero": "node scripts/qa-hero.mjs",
    "reviews:sync": "node scripts/sync-reviews.mjs",
    "reviews:status": "node scripts/sync-reviews.mjs --status"
  },
  "dependencies": {
    "framer-motion": "^13.2.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.52.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "concurrently": "^9.1.2",
    "prettier": "^3.9.6",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  }
}
